[Unit]
Description=BodyInk verified DPU overlay preparation
Requires=dfx-mgr.service
After=local-fs.target dfx-mgr.service
Before=bodyink-live.service
RequiresMountsFor=/home/ubuntu
StartLimitIntervalSec=300
StartLimitBurst=1

[Service]
Type=oneshot
User=root
WorkingDirectory=/
Environment=BODYINK_PROBE_LIBRARY_PATH=/home/ubuntu/.local/share/xilinx-agent-bridge/vart2-static-init
ExecStart=/usr/local/libexec/bodyink/prepare_dpu.sh
RemainAfterExit=yes
Restart=no
TimeoutStartSec=150
TimeoutStopSec=5
UMask=0022
StandardOutput=journal
StandardError=journal

# Intentionally no ExecStop/unload action and no reboot/failure action.
# Pulled in by bodyink-live.service Requires=, not independently enabled.
