# All measurements use original V4L2 timestamps, not an artificial output FPS.
# Exhibition configuration: 160 = 16 ms. At 60 the producer can serve each new frame.
BODYINK_CAMERA_ARGS="--device /dev/v4l/by-id/usb-Generic_USB_Camera3___BODYINK_CAMERA_SERIAL__-video-index0 --exposure 160 --stats-interval 10 --timeout 3 --buffers 8 --snapshot-fps 60"
