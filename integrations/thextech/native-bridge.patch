@@ -0,0 +1,282 @@
+// Private suite input/lifecycle adapter. SPDX-License-Identifier: GPL-3.0-or-later
+#include "ink_host.h"
+#include "ink_host_protocol.h"
+#include "../controls.h"
+#include "../globals.h"
+#include "../game_main.h"
+#include <new>
+#include <cmath>
+#include <SDL2/SDL.h>
+// Include X11 last: its legacy macros must not affect engine declarations.
+#include <SDL2/SDL_syswm.h>
+
+namespace InkHost
+{
+static Channel channel;
+static uint32_t input_updates = 0, logic_ticks = 0, render_frames = 0;
+static uint32_t actual_size = 0, window_id = 0, restarts_completed = 0;
+static bool input_bound = false;
+static bool restart_in_progress = false;
+static bool restart_waiting_for_frame = false;
+static uint64_t last_publish_ms = 0, last_telemetry_ms = 0;
+static uint64_t active_ms = 0, last_account_ms = 0;
+static uint32_t last_flags = ~0U, last_ack_seq = ~0U;
+
+static uint32_t phase()
+{
+    if(LoadingInProcess || !GameIsActive)
+        return 0;
+    if(GameOutro)
+        return 4;
+    if(GameMenu)
+        return 1;
+    return LevelSelect ? 2 : 3;
+}
+
+static uint32_t pathHash(const std::string& value)
+{
+    uint32_t hash = 2166136261U;
+    for(unsigned char c : value)
+        hash = (hash ^ c) * 16777619U;
+    return hash;
+}
+
+static uint32_t centi(double value)
+{
+    if(!std::isfinite(value))
+        return 0;
+    double scaled = std::round(value * 100.0);
+    scaled = scaled < double(INT32_MIN) ? double(INT32_MIN) : scaled;
+    scaled = scaled > double(INT32_MAX) ? double(INT32_MAX) : scaled;
+    return uint32_t(int32_t(scaled));
+}
+
+bool enabled()
+{
+    channel.init();
+    return channel.requested;
+}
+
+void poll()
+{
+    if(enabled())
+        channel.drain(phase() == 3 && int(GamePaused) == 0 && !TestLevel && !LevelEditor && !BattleMode &&
+                      !IsHubLevel && !IsEpisodeIntro && LevelMacro == LEVELMACRO_OFF &&
+                      !FullFileName.empty());
+}
+
+bool paused() { return enabled() && channel.isPaused(clockMs()); }
+bool muted() { return enabled() && channel.mute != 0; }
+bool quitting() { return enabled() && channel.quit; }
+bool restartPending() { return enabled() && channel.restart_pending && !restart_in_progress; }
+void beginRestart() { restart_in_progress = true; }
+void levelSetupReady()
+{
+    if(restart_in_progress)
+        restart_waiting_for_frame = true;
+}
+
+void restartCompleted(bool success)
+{
+    if(!restart_in_progress)
+        return;
+    channel.restart_pending = false;
+    restart_in_progress = false;
+    restart_waiting_for_frame = false;
+    channel.need_release = true;
+    if(success)
+    {
+        ++restarts_completed;
+        channel.error = Okay;
+    }
+    else
+        channel.error = ReloadFailed;
+}
+
+bool updateWindow(SDL_Window* window)
+{
+    if(!enabled() || !window)
+        return false;
+    const int desired_w = int(channel.desired_size & 0xffffU);
+    const int desired_h = int(channel.desired_size >> 16);
+    int width = 0, height = 0;
+    SDL_GetWindowSize(window, &width, &height);
+    const int previous_w = width, previous_h = height;
+    if(channel.desired_size && desired_w >= 320 && desired_w <= 3840 &&
+       desired_h >= 200 && desired_h <= 2160 &&
+       (desired_w != width || desired_h != height))
+    {
+        SDL_SetWindowSize(window, desired_w, desired_h);
+        SDL_GetWindowSize(window, &width, &height);
+    }
+    actual_size = uint32_t(width) | (uint32_t(height) << 16);
+    // The host has already reparented the exact XID before issuing Run.
+    if(channel.received && !channel.isPaused(clockMs()) &&
+       !(SDL_GetWindowFlags(window) & SDL_WINDOW_SHOWN))
+        SDL_ShowWindow(window);
+    if(!window_id)
+    {
+        SDL_SysWMinfo info = {};
+        SDL_VERSION(&info.version);
+        if(SDL_GetWindowWMInfo(window, &info))
+        {
+#if defined(SDL_VIDEO_DRIVER_X11)
+            if(info.subsystem == SDL_SYSWM_X11)
+                window_id = uint32_t(info.info.x11.window);
+#endif
+        }
+    }
+    return width != previous_w || height != previous_h;
+}
+
+void didPresent()
+{
+    if(enabled())
+    {
+        ++render_frames;
+        // File parsing is not a usable restart. Player/resource setup and the
+        // first native presentation must have completed. That first usable
+        // screen may be a start-event dialog requiring player confirmation.
+        if(restart_in_progress && restart_waiting_for_frame && input_bound && phase() == 3)
+            restartCompleted(true);
+    }
+}
+
+void didLogic()
+{
+    if(enabled())
+        ++logic_ticks;
+}
+
+void publish(bool audio_paused)
+{
+    if(!enabled())
+        return;
+    const uint64_t now = clockMs();
+    const bool stale = channel.stale(now);
+    const bool is_paused = channel.isPaused(now);
+    const bool ready = actual_size && window_id && input_bound && render_frames && phase();
+    const uint32_t flags = (ready ? 1U : 0U) | (is_paused ? 2U : 0U) |
+        (stale ? 4U : 0U) | (audio_paused ? 8U : 0U) |
+        (channel.restart_pending ? 16U : 0U) | (channel.peer_closed ? 32U : 0U) |
+        (int(GamePaused) != 0 ? 64U : 0U);
+    // Mute is not a simulation pause. Native dialogs are a simulation pause.
+    if(last_account_ms && ready && !is_paused && int(GamePaused) == 0)
+        active_ms += now - last_account_ms;
+    last_account_ms = now;
+    if(now - last_publish_ms >= 100 || channel.seq != last_ack_seq || flags != last_flags)
+    {
+        Packet p = {{Magic, Version, State, channel.session, channel.seq,
+            channel.operation, flags, actual_size, window_id, channel.held(),
+            input_updates, render_frames, phase(),
+            stale && channel.error == Okay ? uint32_t(Stale) : channel.error,
+            uint32_t(now), restarts_completed}};
+        if(channel.sendPacket(p))
+        {
+            last_publish_ms = now;
+            last_ack_seq = channel.seq;
+            last_flags = flags;
+        }
+    }
+    if(now - last_telemetry_ms >= 250)
+    {
+        const int32_t lives100 = int32_t(std::lround(double(Lives) * 100.0));
+        Packet p = {{Magic, Version, Telemetry, channel.session, channel.seq,
+            logic_ticks, render_frames, uint32_t(Score), uint32_t(Coins),
+            uint32_t(lives100), uint32_t(numStars), pathHash(FullFileName),
+            pathHash(FileNamePathWorld + FileNameFullWorld), uint32_t(active_ms),
+            phase(), uint32_t(LevelBeatCode)}};
+        if(channel.sendPacket(p))
+            last_telemetry_ms = now;
+        if(numPlayers > 0 && phase() == 3)
+        {
+            // Diagnostic coordinates prove that private input moved the actual
+            // native player, rather than merely echoing an observed key mask.
+            const auto& player = Player[1];
+            Packet diagnostic = {{Magic, Version, Event, channel.session, channel.seq,
+                1U, centi(player.Location.X), centi(player.Location.Y),
+                centi(player.Location.SpeedX), centi(player.Location.SpeedY),
+                uint32_t(player.Character), uint32_t(player.State), player.Dead ? 1U : 0U,
+                uint32_t(player.Section), pathHash(FullFileName), 0U}};
+            channel.sendPacket(diagnostic);
+        }
+    }
+}
+
+class HostProfile final : public Controls::InputMethodProfile
+{
+public:
+    HostProfile() { Name = "Suite P1"; }
+    bool PollPrimaryButton(Controls::ControlsClass, size_t) override { return false; }
+    bool PollSecondaryButton(Controls::ControlsClass, size_t) override { return false; }
+    bool DeletePrimaryButton(Controls::ControlsClass, size_t) override { return false; }
+    bool DeleteSecondaryButton(Controls::ControlsClass, size_t) override { return false; }
+    const char* NamePrimaryButton(Controls::ControlsClass, size_t) override { return "Suite"; }
+    const char* NameSecondaryButton(Controls::ControlsClass, size_t) override { return ""; }
+    void SaveConfig(IniProcessing*) override {}
+    void LoadConfig(IniProcessing*) override {}
+};
+
+class HostMethod final : public Controls::InputMethod
+{
+public:
+    ~HostMethod() override { input_bound = false; }
+    bool Update(int, Controls_t& controls, CursorControls_t&, EditorControls_t&,
+                Controls::HotkeysPressed_t&) override
+    {
+        const uint32_t held = channel.held();
+        for(size_t i = 0; i < Controls::PlayerControls::n_buttons; ++i)
+            Controls::PlayerControls::GetButton(controls, i) = (held & (1U << i)) != 0;
+        ++input_updates;
+        return true;
+    }
+    void Rumble(int, float) override {}
+};
+
+class HostType final : public Controls::InputMethodType
+{
+protected:
+    Controls::InputMethodProfile* AllocateProfile() noexcept override
+    { return new(std::nothrow) HostProfile; }
+public:
+    HostType() { Name = "InkSuitePrivate"; }
+    bool TestProfileType(Controls::InputMethodProfile* p) override
+    { return dynamic_cast<HostProfile*>(p) != nullptr; }
+    bool RumbleSupported() override { return false; }
+    void UpdateControlsPre() override {}
+    void UpdateControlsPost() override
+    {
+        const uint32_t held = channel.held();
+        SharedControls.MenuUp = (held & (1U << 0)) != 0;
+        SharedControls.MenuDown = (held & (1U << 1)) != 0;
+        SharedControls.MenuLeft = (held & (1U << 2)) != 0;
+        SharedControls.MenuRight = (held & (1U << 3)) != 0;
+        SharedControls.MenuDo = (held & (1U << 10)) != 0;
+        // Drop/add closes its ready player panel through MenuBack, unlike
+        // messages/menus which consume MenuDo. Give the host's Confirm its
+        // intended "continue" meaning only in that native UI. Never synthesize
+        // P1 Jump: the same world/game frame resumes after the panel closes.
+        SharedControls.MenuBack = (held & (1U << 11)) != 0 ||
+            (GamePaused == PauseCode::DropAdd && (held & (1U << 10)) != 0);
+        SharedControls.QuitCredits = (held & ((1U << 10) | (1U << 11))) != 0;
+    }
+    Controls::InputMethod* Poll(const std::vector<Controls::InputMethod*>& methods) noexcept override
+    {
+        for(const auto* method : methods)
+            if(method)
+                return nullptr; // One suite-owned P1, never a duplicate reader.
+        auto* method = new(std::nothrow) HostMethod;
+        if(!method)
+            return nullptr;
+        method->Name = "Suite P1";
+        method->Type = this;
+        input_bound = true;
+        return method;
+    }
+};
+
+Controls::InputMethodType* createInputType()
+{
+    return new HostType;
+}
+}
