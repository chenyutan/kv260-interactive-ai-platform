@@ -0,0 +1,186 @@
+// Linux-only private packet transport. SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <climits>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+#include <endian.h>
+
+namespace InkHost
+{
+constexpr uint32_t Magic = 0x584b4e49U;
+constexpr uint32_t Version = 1;
+enum Kind : uint32_t { Request = 1, State = 2, Telemetry = 3, Event = 4 };
+enum Operation : uint32_t { Run = 0, Pause = 1, Quit = 2, Restart = 3 };
+enum Error : uint32_t { Okay = 0, Malformed = 1, Stale = 2, WrongPhase = 3, ReloadFailed = 4 };
+using Packet = std::array<uint32_t, 16>;
+static_assert(sizeof(Packet) == 64, "Private protocol packet must remain 64 bytes");
+
+inline uint64_t clockMs()
+{
+    timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return uint64_t(now.tv_sec) * 1000 + uint64_t(now.tv_nsec) / 1000000;
+}
+
+// A complete SOCK_SEQPACKET message is the publication boundary. There is no
+// cross-language shared-memory race and the parent owns all physical input.
+class Channel
+{
+public:
+    int fd = -1;
+    bool initialized = false;
+    bool requested = false;
+    bool received = false;
+    bool peer_closed = false;
+    bool quit = false;
+    bool restart_pending = false;
+    bool need_release = true;
+    uint32_t session = 0, seq = 0, operation = Pause, held_mask = 0;
+    uint32_t desired_size = 0, mute = 0, error = Okay;
+    uint64_t started_ms = 0, last_rx_ms = 0;
+
+    void init()
+    {
+        if(initialized)
+            return;
+        initialized = true;
+        started_ms = last_rx_ms = clockMs();
+        const char* value = std::getenv("INK_XTECH_FD");
+        if(!value || !*value)
+            return;
+        requested = true;
+        char* end = nullptr;
+        errno = 0;
+        long candidate = std::strtol(value, &end, 10);
+        int type = 0;
+        socklen_t type_size = sizeof(type);
+        sockaddr_storage address = {};
+        socklen_t address_size = sizeof(address);
+        if(errno || !end || *end || candidate < 3 || candidate > INT_MAX ||
+           getsockopt(int(candidate), SOL_SOCKET, SO_TYPE, &type, &type_size) ||
+           type != SOCK_SEQPACKET ||
+           getsockname(int(candidate), reinterpret_cast<sockaddr*>(&address), &address_size) ||
+           address.ss_family != AF_UNIX)
+        {
+            std::fprintf(stderr, "INK_XTECH_FD: expected a private AF_UNIX SOCK_SEQPACKET descriptor\n");
+            std::exit(2);
+        }
+        fd = int(candidate);
+        if(fcntl(fd, F_SETFD, FD_CLOEXEC) ||
+           fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK))
+        {
+            std::fprintf(stderr, "INK_XTECH_FD: failed to configure private descriptor\n");
+            std::exit(2);
+        }
+    }
+
+    bool stale(uint64_t now) const
+    {
+        return peer_closed || !received || now - last_rx_ms > 2000;
+    }
+
+    bool isPaused(uint64_t now) const
+    {
+        return !quit && (operation == Pause || stale(now));
+    }
+
+    void drain(bool level_restart_allowed)
+    {
+        init();
+        if(fd < 0)
+            return;
+        bool previously_paused = isPaused(clockMs());
+        for(unsigned n = 0; n < 64; ++n)
+        {
+            // MSG_TRUNC reports oversize packets instead of accepting a valid
+            // prefix. The buffer is exactly one immutable protocol packet.
+            Packet p = {};
+            ssize_t count = recv(fd, p.data(), sizeof(p), MSG_DONTWAIT | MSG_TRUNC);
+            if(count < 0)
+            {
+                if(errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+                    peer_closed = true;
+                break;
+            }
+            if(count == 0)
+            {
+                peer_closed = true;
+                break;
+            }
+            for(auto& word : p)
+                word = le32toh(word);
+            bool reserved = false;
+            for(unsigned i = 9; i < p.size(); ++i)
+                reserved |= p[i] != 0;
+            if(count != ssize_t(sizeof(p)) || p[0] != Magic || p[1] != Version ||
+               p[2] != Request || !p[3] || p[5] > Restart || (p[6] & ~0xfffU) ||
+               p[8] > 1 || reserved)
+            {
+                error = Malformed;
+                continue;
+            }
+            if(received && (p[3] != session || int32_t(p[4] - seq) <= 0))
+                continue;
+            uint32_t previous_operation = operation;
+            received = true;
+            session = p[3];
+            seq = p[4];
+            operation = p[5];
+            held_mask = p[6];
+            desired_size = p[7];
+            mute = p[8];
+            last_rx_ms = clockMs();
+            if(operation != Restart)
+                error = Okay;
+            if(operation == Quit)
+                quit = true;
+            if(operation == Restart && previous_operation != Restart)
+            {
+                if(level_restart_allowed)
+                {
+                    restart_pending = true;
+                    need_release = true;
+                    error = Okay;
+                }
+                else
+                    error = WrongPhase;
+            }
+        }
+        const bool now_paused = isPaused(clockMs());
+        if(now_paused || previously_paused != now_paused)
+            need_release = true;
+        if(!now_paused && held_mask == 0)
+            need_release = false;
+    }
+
+    uint32_t held()
+    {
+        if(!requested || isPaused(clockMs()) || quit || restart_pending || need_release)
+            return 0;
+        return held_mask & 0xfffU;
+    }
+
+    bool sendPacket(Packet p)
+    {
+        // A peer may close only its write half. Still attempt a final receipt
+        // to its read half; MSG_NOSIGNAL makes a fully closed peer harmless.
+        if(fd < 0 || !received)
+            return false;
+        for(auto& word : p)
+            word = htole32(word);
+        ssize_t count = send(fd, p.data(), sizeof(p), MSG_DONTWAIT | MSG_NOSIGNAL);
+        if(count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+            peer_closed = true;
+        return count == ssize_t(sizeof(p));
+    }
+};
+}
